	properties := commonProperties(common)
	properties = append(properties,
		Property{Name: "open", Value: boolProperty(props.Open)},
		Property{Name: "anchor", Value: decimalU64(props.Anchor)},
		Property{Name: "placement", Value: decimalU64(uint64(props.Placement))},
		Property{Name: "offsetMilli", Value: decimalI64(int64(props.OffsetMilli))},
