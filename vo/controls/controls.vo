func EncodeVirtualCollectionProps(props VirtualCollectionProps,
	common CommonProps) []byte {
	if props.ItemCount == 0 || props.VisibleCount == 0 ||
		props.FirstVisible >= props.ItemCount ||
		uint64(props.VisibleCount) > props.ItemCount-props.FirstVisible ||
		props.EstimatedItemSizeMilli == 0 || props.Axis > 1 ||
		props.Revision == 0 {
		return nil
	}
	properties := commonProperties(common)
	properties = append(properties,
		Property{Name: "itemCount", Value: decimalU64(props.ItemCount)},
		Property{Name: "firstVisible", Value: decimalU64(props.FirstVisible)},
		Property{Name: "visibleCount",
			Value: decimalU64(uint64(props.VisibleCount))},
		Property{Name: "overscan", Value: decimalU64(uint64(props.Overscan))},
		Property{Name: "estimatedItemSizeMilli",
			Value: decimalU64(uint64(props.EstimatedItemSizeMilli))},
		Property{Name: "axis", Value: decimalU64(uint64(props.Axis))},
		Property{Name: "revision", Value: decimalU64(props.Revision)})
	return EncodeProperties(properties)
}

