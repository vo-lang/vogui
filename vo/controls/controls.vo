		Property{Name: "atomic", Value: boolProperty(props.Atomic)},
		Property{Name: "relevant", Value: decimalU64(uint64(props.Relevant))},
		Property{Name: "message", Value: props.Message},
		Property{Name: "revision", Value: decimalU64(props.Revision)})
	return EncodeProperties(properties)
}

