	return EncodeProperties(properties)
}

func EncodeProgressProps(props ProgressProps, common CommonProps) []byte {
	if len(props.Label) == 0 || !props.Indeterminate &&
		(props.MaximumMilli == 0 || props.ValueMilli > props.MaximumMilli) {
		return nil
