func EncodeCommonProps(common CommonProps) []byte {
	return EncodeProperties(commonProperties(common))
}

func commonProperties(common CommonProps) []Property {
	properties := []Property{
		Property{Name: "accessibleName", Value: common.AccessibleName},
		Property{Name: "accessibleDescription",
			Value: common.AccessibleDescription},
		Property{Name: "disabled", Value: boolProperty(common.Disabled)},
		Property{Name: "hidden", Value: boolProperty(common.Hidden)},
		Property{Name: "tabIndex", Value: decimalI64(int64(common.TabIndex))},
		Property{Name: "role", Value: semanticRoleName(common.Role)},
		Property{Name: "style", Value: decimalU64(common.Style)},
		Property{Name: "class", Value: decimalU64(common.Class)},
	}
	for index, token := range common.ThemeTokens {
		properties = append(properties, Property{
			Name: "themeToken." + decimalU64(uint64(index)),
			Value: token,
		})
	}
	return properties
}

func semanticRoleName(role SemanticRole) string {
	switch role {
	case RoleNone:
		return ""
	case RoleText:
		return "text"
	case RoleImage:
		return "img"
	case RoleButton:
		return "button"
	case RoleTextField:
		return "textbox"
	case RoleCheckbox:
		return "checkbox"
	case RoleSlider:
		return "slider"
	case RoleList:
		return "list"
	case RoleGrid:
		return "grid"
	case RoleLink:
		return "link"
	case RoleSwitch:
		return "switch"
	case RoleRadio:
		return "radio"
	case RoleRadioGroup:
		return "radiogroup"
	case RoleListBox:
		return "listbox"
	case RoleOption:
		return "option"
	case RoleCombobox:
		return "combobox"
	case RoleForm:
		return "form"
	case RoleLabel:
		return "label"
	case RoleProgress:
		return "progressbar"
	case RoleTab:
		return "tab"
	case RoleTabList:
		return "tablist"
	case RoleTabPanel:
		return "tabpanel"
	case RoleDialog:
		return "dialog"
	case RoleTooltip:
		return "tooltip"
	case RoleMenu:
		return "menu"
	case RoleMenuItem:
		return "menuitem"
	case RoleTable:
		return "table"
	case RoleRow:
		return "row"
	case RoleCell:
		return "cell"
	case RoleTree:
		return "tree"
	case RoleTreeItem:
		return "treeitem"
	case RoleStatus:
		return "status"
	case RoleAlert:
		return "alert"
	}
	return ""
}

func boolProperty(value bool) string {
	if value {
		return "true"
	}
	return "false"
}

func decimalI64(value int64) string {
	if value >= 0 {
		return decimalU64(uint64(value))
	}
	return "-" + decimalU64(uint64(-(value + 1)) + 1)
}

func decimalU64(value uint64) string {
	if value == 0 {
		return "0"
	}
	digits := make([]byte, 0, 20)
	for value != 0 {
		digits = append(digits, byte('0' + value%10))
		value /= 10
	}
	for left, right := 0, len(digits)-1; left < right; left, right = left+1, right-1 {
		digits[left], digits[right] = digits[right], digits[left]
	}
	return string(digits)
}

func EncodeProperties(properties []Property) []byte {
	if len(properties) > 4294967295 {
		return nil
	}
	bytes := []byte{'V', 'G', 'P', '1'}
	bytes = appendPropertyU32(bytes, uint32(len(properties)))
	for _, property := range properties {
		if len(property.Name) == 0 || len(property.Name) > 65535 || len(property.Value) > 4294967295 {
			return nil
		}
		bytes = appendPropertyU16(bytes, uint16(len(property.Name)))
		bytes = appendPropertyU32(bytes, uint32(len(property.Value)))
		bytes = append(bytes, []byte(property.Name)...)
		bytes = append(bytes, []byte(property.Value)...)
	}
	return bytes
}

func appendPropertyU16(bytes []byte, value uint16) []byte {
	return append(bytes, byte(value), byte(value >> 8))
}

func appendPropertyU32(bytes []byte, value uint32) []byte {
	return append(bytes, byte(value), byte(value >> 8), byte(value >> 16), byte(value >> 24))
}

type TextFieldProps struct {
	Value string
	Placeholder string
	Disabled bool
	ReadOnly bool
	Multiline bool
	EditRevision uint64
	ConfirmedEditSequence uint64
}

type CompositionState uint8

const (
	CompositionInactive CompositionState = iota
	CompositionStarted
	CompositionUpdating
	CompositionCommitted
	CompositionCancelled
)

type TextEditEvent struct {
	Value string
	SelectionStart uint32
	SelectionEnd uint32
	Composing bool
	EditRevision uint64
	EditSequence uint64
	Composition CompositionState
	HasReplacement bool
	ReplacementStart uint32
	ReplacementEnd uint32
}

type FocusRequest struct {
	RootIndex uint32
	RootGeneration uint32
	NodeIndex uint32
	NodeGeneration uint32
	BindingGeneration uint32
	MinAppliedRevision uint64
	DeadlineMillis uint64
	PreventScroll bool
}

func EncodeTextEditEvent(event TextEditEvent) []byte {
	if !ValidTextEditEvent(event) {
		return nil
	}
	text := []byte(event.Value)
	bytes := []byte{'V', 'G', 'T', '1'}
	bytes = appendPropertyU64(bytes, event.EditSequence)
	bytes = appendPropertyU64(bytes, event.EditRevision)
	bytes = appendPropertyU32(bytes, event.SelectionStart)
	bytes = appendPropertyU32(bytes, event.SelectionEnd)
	bytes = appendPropertyU32(bytes, event.ReplacementStart)
	bytes = appendPropertyU32(bytes, event.ReplacementEnd)
	bytes = append(bytes, byte(event.Composition))
	flags := byte(0)
	if event.HasReplacement {
		flags |= 1
	}
	bytes = append(bytes, flags, 0, 0)
	bytes = appendPropertyU32(bytes, uint32(len(text)))
	return append(bytes, text...)
}

func DecodeTextEditEvent(bytes []byte) (TextEditEvent, bool) {
	if len(bytes) < 44 || bytes[0] != 'V' || bytes[1] != 'G' || bytes[2] != 'T' || bytes[3] != '1' ||
		bytes[37] > 1 ||
		bytes[38] != 0 ||
		bytes[39] != 0 {
		return TextEditEvent{}, false
	}
	textLength := int(readPropertyU32(bytes, 40))
	if textLength != len(bytes) - 44 {
		return TextEditEvent{}, false
	}
	composition := CompositionState(bytes[36])
	event := TextEditEvent{
		Value: string(bytes[44:]), SelectionStart: readPropertyU32(bytes, 20),
		SelectionEnd: readPropertyU32(bytes, 24),
		Composing: composition == CompositionStarted || composition == CompositionUpdating,
		EditRevision: readPropertyU64(bytes, 12), EditSequence: readPropertyU64(bytes, 4),
		Composition: composition, HasReplacement: bytes[37] == 1,
		ReplacementStart: readPropertyU32(bytes, 28), ReplacementEnd: readPropertyU32(bytes, 32),
	}
	return event, ValidTextEditEvent(event)
}

func ValidTextEditEvent(event TextEditEvent) bool {
	text := []byte(event.Value)
	if event.EditSequence == 0 || event.Composition > CompositionCancelled ||
		event.SelectionStart > event.SelectionEnd ||
		uint64(event.SelectionEnd) > uint64(len(text)) ||
		!textByteBoundary(text, event.SelectionStart) ||
		!textByteBoundary(text, event.SelectionEnd) {
		return false
	}
	composing := event.Composition == CompositionStarted || event.Composition == CompositionUpdating
	if event.Composing != composing {
		return false
	}
	if !event.HasReplacement {
		return event.ReplacementStart == 0 && event.ReplacementEnd == 0
	}
	return event.ReplacementStart <= event.ReplacementEnd &&
		uint64(event.ReplacementEnd) <= uint64(len(text)) &&
		textByteBoundary(text, event.ReplacementStart) &&
		textByteBoundary(text, event.ReplacementEnd)
}

func textByteBoundary(text []byte, offset uint32) bool {
	if uint64(offset) > uint64(len(text)) {
		return false
	}
	if int(offset) == len(text) || offset == 0 {
		return true
	}
	return text[offset] & 0xc0 != 0x80
}

func appendPropertyU64(bytes []byte, value uint64) []byte {
	return append(bytes, byte(value), byte(value >> 8), byte(value >> 16), byte(value >> 24), byte(value >>
		32), byte(value >> 40), byte(value >> 48), byte(value >> 56))
}

func readPropertyU32(bytes []byte, offset int) uint32 {
	return uint32(bytes[offset]) | uint32(bytes[offset + 1]) << 8 | uint32(bytes[offset + 2]) << 16 |
		uint32(bytes[offset + 3]) << 24
}

func readPropertyU64(bytes []byte, offset int) uint64 {
	return uint64(readPropertyU32(bytes, offset)) | uint64(readPropertyU32(bytes, offset + 4)) << 32
}
