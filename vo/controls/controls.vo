type ButtonProps struct {
	Label string
	Disabled bool
	DefaultAction bool
}

type CommonProps struct {
	AccessibleName string
	AccessibleDescription string
	Disabled bool
	Hidden bool
	TabIndex int32
	Role SemanticRole
	ThemeTokens []string
	Style uint64
	Class uint64
}

type TextProps struct {
	Text string
	Locale string
	Direction uint32
	Selectable bool
	Live uint32
}

type ImageProps struct {
	Resource uint64
	Alt string
	Fit uint32
	WidthMilli uint32
	HeightMilli uint32
}

type LinkProps struct {
	Label string
	Route uint64
	ExternalUrl string
	Target uint32
	Disabled bool
}

type ToggleProps struct {
	Label string
	Checked bool
	Indeterminate bool
	Disabled bool
	Required bool
}

type SliderProps struct {
	Label string
	ValueMilli int64
	MinimumMilli int64
	MaximumMilli int64
	StepMilli uint64
	Orientation uint32
	Disabled bool
}

type Option struct {
	Id uint64
	Label string
	Description string
	Disabled bool
}

type SelectionProps struct {
	Label string
	Options []Option
	Selected []uint64
	Active uint64
	Multiple bool
	Expanded bool
	Required bool
	Disabled bool
}

type FormProps struct {
	Id uint64
	ValidationRevision uint64
	Valid bool
	Submitting bool
	Autocomplete bool
}

type ProgressProps struct {
	Label string
	ValueMilli uint64
	MaximumMilli uint64
	Indeterminate bool
}

type TabsProps struct {
	Selected uint64
	Activation uint32
	Orientation uint32
	LoopFocus bool
}

type DisclosureProps struct {
	Expanded bool
	Disabled bool
	Controls uint64
}

type DialogProps struct {
	Open bool
	Modal bool
	DismissOnEscape bool
	DismissOnBackdrop bool
	InitialFocus uint64
	ReturnFocus uint64
	Label string
	Description string
}

type OverlayProps struct {
	Open bool
	Anchor uint64
	Placement uint32
	OffsetMilli int32
	Flip bool
	Shift bool
	TrapFocus bool
}

type VirtualCollectionProps struct {
	ItemCount uint64
	FirstVisible uint64
	VisibleCount uint32
	Overscan uint32
	EstimatedItemSizeMilli uint32
	Axis uint32
	Revision uint64
}

type TableProps struct {
	RowCount uint64
	ColumnCount uint32
	SelectionMode uint32
	SortColumn uint32
	SortDirection uint32
	Virtualized bool
}

type LiveRegionProps struct {
	Politeness uint32
	Atomic bool
	Relevant uint32
	Message string
	Revision uint64
}

type Property struct {
	Name string
	Value string
}

func EncodeButtonProps(props ButtonProps, common CommonProps) []byte {
	if len(props.Label) == 0 || props.Disabled != common.Disabled {
		return nil
	}
	properties := commonProperties(common)
	properties = append(properties,
		Property{Name: "label", Value: props.Label},
		Property{Name: "defaultAction", Value: boolProperty(props.DefaultAction)})
	return EncodeProperties(properties)
}

func EncodeTextProps(props TextProps, common CommonProps) []byte {
	if props.Direction > 2 || props.Live > 3 {
		return nil
	}
	properties := commonProperties(common)
	properties = append(properties,
		Property{Name: "text", Value: props.Text},
		Property{Name: "locale", Value: props.Locale},
		Property{Name: "direction", Value: decimalU64(uint64(props.Direction))},
		Property{Name: "selectable", Value: boolProperty(props.Selectable)},
		Property{Name: "live", Value: decimalU64(uint64(props.Live))})
	return EncodeProperties(properties)
}

func EncodeImageProps(props ImageProps, common CommonProps) []byte {
	if props.Resource == 0 || props.Fit > 4 {
		return nil
	}
	properties := commonProperties(common)
	properties = append(properties,
		Property{Name: "resource", Value: decimalU64(props.Resource)},
		Property{Name: "alt", Value: props.Alt},
		Property{Name: "fit", Value: decimalU64(uint64(props.Fit))},
		Property{Name: "widthMilli", Value: decimalU64(uint64(props.WidthMilli))},
		Property{Name: "heightMilli", Value: decimalU64(uint64(props.HeightMilli))})
	return EncodeProperties(properties)
}

func EncodeLinkProps(props LinkProps, common CommonProps) []byte {
	if len(props.Label) == 0 || props.Route == 0 && len(props.ExternalUrl) == 0 ||
		props.Route != 0 && len(props.ExternalUrl) != 0 || props.Target > 3 ||
		props.Disabled != common.Disabled {
		return nil
	}
	properties := commonProperties(common)
	properties = append(properties,
		Property{Name: "label", Value: props.Label},
		Property{Name: "route", Value: decimalU64(props.Route)},
		Property{Name: "externalUrl", Value: props.ExternalUrl},
		Property{Name: "target", Value: decimalU64(uint64(props.Target))})
	return EncodeProperties(properties)
}

func EncodeTextFieldProps(props TextFieldProps, common CommonProps) []byte {
	if props.EditRevision == 0 ||
		props.Multiline && props.ReadOnly && props.Disabled {
		return nil
	}
	properties := commonProperties(common)
	properties = append(properties,
		Property{Name: "value", Value: props.Value},
		Property{Name: "placeholder", Value: props.Placeholder},
		Property{Name: "readOnly", Value: boolProperty(props.ReadOnly)},
		Property{Name: "multiline", Value: boolProperty(props.Multiline)},
		Property{Name: "editRevision", Value: decimalU64(props.EditRevision)},
		Property{Name: "confirmedEditSequence",
			Value: decimalU64(props.ConfirmedEditSequence)})
	return EncodeProperties(properties)
}

func EncodeToggleProps(props ToggleProps, common CommonProps) []byte {
	if len(props.Label) == 0 || props.Indeterminate && props.Checked {
		return nil
	}
	properties := commonProperties(common)
	properties = append(properties,
		Property{Name: "label", Value: props.Label},
		Property{Name: "checked", Value: boolProperty(props.Checked)},
		Property{Name: "indeterminate", Value: boolProperty(props.Indeterminate)},
		Property{Name: "required", Value: boolProperty(props.Required)})
	return EncodeProperties(properties)
}

func EncodeSliderProps(props SliderProps, common CommonProps) []byte {
	if len(props.Label) == 0 || props.MinimumMilli > props.MaximumMilli ||
		props.ValueMilli < props.MinimumMilli || props.ValueMilli > props.MaximumMilli ||
		props.StepMilli == 0 || props.Orientation > 1 ||
		props.Disabled != common.Disabled {
		return nil
	}
	properties := commonProperties(common)
	properties = append(properties,
		Property{Name: "label", Value: props.Label},
		Property{Name: "valueMilli", Value: decimalI64(props.ValueMilli)},
		Property{Name: "minimumMilli", Value: decimalI64(props.MinimumMilli)},
		Property{Name: "maximumMilli", Value: decimalI64(props.MaximumMilli)},
		Property{Name: "stepMilli", Value: decimalU64(props.StepMilli)},
		Property{Name: "orientation", Value: decimalU64(uint64(props.Orientation))})
	return EncodeProperties(properties)
}

func EncodeSelectionProps(props SelectionProps, common CommonProps) []byte {
	if len(props.Label) == 0 || len(props.Options) > 48 ||
		len(props.Selected) > 48 || !props.Multiple && len(props.Selected) > 1 {
		return nil
	}
	properties := commonProperties(common)
	properties = append(properties,
		Property{Name: "label", Value: props.Label},
		Property{Name: "multiple", Value: boolProperty(props.Multiple)},
		Property{Name: "expanded", Value: boolProperty(props.Expanded)},
		Property{Name: "required", Value: boolProperty(props.Required)},
		Property{Name: "active", Value: decimalU64(props.Active)})
	for index, option := range props.Options {
		if option.Id == 0 || len(option.Label) == 0 {
			return nil
		}
		for previous := 0; previous < index; previous++ {
			if props.Options[previous].Id == option.Id {
				return nil
			}
		}
		prefix := "option." + decimalU64(option.Id) + "."
		properties = append(properties,
			Property{
				Name: "optionOrder." + decimalU64(uint64(index)),
				Value: decimalU64(option.Id),
			},
			Property{Name: prefix + "label", Value: option.Label},
			Property{Name: prefix + "description", Value: option.Description},
			Property{Name: prefix + "disabled",
				Value: boolProperty(option.Disabled)})
	}
	for index, selected := range props.Selected {
		if selected == 0 || index > 0 && props.Selected[index-1] >= selected {
			return nil
		}
		properties = append(properties, Property{
			Name: "selected." + decimalU64(uint64(index)),
			Value: decimalU64(selected),
		})
	}
	return EncodeProperties(properties)
}

func EncodeDialogProps(props DialogProps, common CommonProps) []byte {
	if props.Open && len(props.Label) == 0 {
		return nil
	}
	properties := commonProperties(common)
	properties = append(properties,
		Property{Name: "open", Value: boolProperty(props.Open)},
		Property{Name: "modal", Value: boolProperty(props.Modal)},
		Property{Name: "dismissOnEscape",
			Value: boolProperty(props.DismissOnEscape)},
		Property{Name: "dismissOnBackdrop",
			Value: boolProperty(props.DismissOnBackdrop)},
		Property{Name: "initialFocus", Value: decimalU64(props.InitialFocus)},
		Property{Name: "returnFocus", Value: decimalU64(props.ReturnFocus)},
		Property{Name: "label", Value: props.Label},
		Property{Name: "description", Value: props.Description})
	return EncodeProperties(properties)
}

