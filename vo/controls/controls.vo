	properties := commonProperties(common)
	properties = append(properties,
		Property{Name: "rowCount", Value: decimalU64(props.RowCount)},
		Property{Name: "columnCount", Value: decimalU64(uint64(props.ColumnCount))},
		Property{Name: "selectionMode", Value: decimalU64(uint64(props.SelectionMode))},
		Property{Name: "sortColumn", Value: decimalU64(uint64(props.SortColumn))},
		Property{Name: "sortDirection", Value: decimalU64(uint64(props.SortDirection))},
		Property{Name: "virtualized", Value: boolProperty(props.Virtualized)})
	return EncodeProperties(properties)
}

func EncodeLiveRegionProps(props LiveRegionProps, common CommonProps) []byte {
	if props.Politeness > 2 || props.Relevant > 15 || props.Revision == 0 {
